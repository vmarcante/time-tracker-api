# Local development environment
# Used with docker-compose.local.yml (API container only)
# Copy this file to .env.local and fill the real values

# Database
DB_URL=jdbc:postgresql://host.docker.internal:5433/time-tracker-digital
DB_USERNAME=postgres
DB_PASSWORD=change_me

# Redis
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Frontend URL
APP_FRONTEND_URL=http://localhost:4200

# Security
APP_ENCRYPTION_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
HEALTH_APP_KEY=change-me-in-production
COOKIE_SECURE=false

# SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=change_me
EMAIL_FROM_ADDRESS=change_me

# Email retry
EMAIL_RETRY_CRON=0 0/30 * * * *
EMAIL_RETRY_MAX_ATTEMPTS=5
