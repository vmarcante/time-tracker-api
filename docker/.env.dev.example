# Development environment
# Used with docker-compose.dev.yml
# Copy this file to .env.dev and fill the real values

# Database
DB_URL=jdbc:postgresql://host.docker.internal:5433/time-tracker-digital
DB_USERNAME=postgres
DB_PASSWORD=change_me

# Redis
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Frontend URL
APP_FRONTEND_URL=https://dev.timetracker.example.com

# Security
APP_ENCRYPTION_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
HEALTH_APP_KEY=change-me-in-production
COOKIE_SECURE=false

# SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=change_me
EMAIL_FROM_ADDRESS=dev-timetracker@example.com

# Email retry
EMAIL_RETRY_CRON=0 0/30 * * * *
EMAIL_RETRY_MAX_ATTEMPTS=5
