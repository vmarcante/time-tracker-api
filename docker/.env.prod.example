# Production environment
# Used with docker-compose.prod.yml
# Copy this file to .env.prod and fill the real values

# Database
DB_URL=jdbc:postgresql://set_me:5432/time-tracker-digital
DB_USERNAME=set_me
DB_PASSWORD=set_me

# Redis
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=set_me
REDIS_DATABASE=0

# Frontend URL
APP_FRONTEND_URL=https://timetracker.example.com

# Security
APP_ENCRYPTION_KEY=set-strong-encryption-key
JWT_SECRET=set-strong-jwt-secret
HEALTH_APP_KEY=set-health-app-key
COOKIE_SECURE=true

# SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=set_me
EMAIL_FROM_ADDRESS=set_me

# Email retry
EMAIL_RETRY_CRON=0 0/30 * * * *
EMAIL_RETRY_MAX_ATTEMPTS=5
